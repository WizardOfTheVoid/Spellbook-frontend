{
  "name": "spellbook",
  "version": "2.6.0",
  "description": "Client-side Chivalry 2 admin overlay.",
  "author": "Magic Trashcan",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.21.1 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n core,app \"npm run core:dev\" \"wait-on tcp:127.0.0.1:48125 && npm run app:dev\"",
    "test": "npm run app:test && npm run core:test",
    "check": "npm run app:check && npm run core:build",
    "build": "npm run core:build && npm run app:build",
    "core:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/core-dev.ps1",
    "core:build": "dotnet build src/core/CoreHost/CoreHost.csproj",
    "core:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publishCore.ps1",
    "core:test": "dotnet run --project src/core/CoreHost.Tests/CoreHost.Tests.csproj",
    "config:write": "node scripts/writePackagedConfig.mjs",
    "preapp:dev": "svelte-kit sync",
    "app:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/app-dev.ps1",
    "app:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generateAppIcons.ps1",
    "preapp:test": "svelte-kit sync && tsx --test src/app/main/evidence/*.test.ts src/app/main/config/packagedAppConfig.test.ts src/app/main/core/corePort.test.ts src/app/main/core/coreProcessController.test.ts src/app/main/core/coreRuntimePath.test.ts src/app/main/services/applicationStartup.test.ts src/app/main/services/gameCommandEligibility.test.ts src/app/main/services/gameActivitySnapshot.test.ts src/app/main/window/debugWindowController.test.ts src/app/main/window/rendererRoute.test.ts src/app/renderer/src/lib/auth/startupState.test.ts src/app/renderer/src/lib/components/account/teamMemberOrder.test.ts src/app/renderer/src/lib/components/account/teamPanelNavigation.test.ts src/app/renderer/src/lib/components/admin/accountStatus.test.ts src/app/renderer/src/lib/components/admin/actions/actionRunsController.test.ts src/app/renderer/src/lib/components/admin/adminUserBan.test.ts src/app/renderer/src/lib/components/app/lazyPanelModules.test.ts src/app/renderer/src/lib/components/dashboard/tabbedList.test.ts src/app/shared/gameState.test.ts src/app/main/gameState/*.test.ts src/app/renderer/src/lib/gameState/*.test.ts src/app/renderer/src/lib/utils/apiResult.test.ts src/app/renderer/src/lib/utils/archiveRequests.test.ts src/app/renderer/src/lib/utils/cacheWarmup.test.ts src/app/renderer/src/lib/utils/gameProcessActions.test.ts src/app/renderer/src/lib/utils/serverArchive.test.ts src/app/renderer/src/lib/utils/serverRowStats.test.ts",
    "app:test": "node scripts/testApp.mjs",
    "postapp:test": "tsx --test src/app/main/debug/*.test.ts src/app/preload/debugBridge.test.ts src/app/renderer/src/lib/components/debug/*.test.ts src/app/main/window/shortcutRegistry.test.ts src/app/main/ipc/discord-install-ipc-handlers.test.ts src/app/main/services/appUpdateService.test.ts src/app/main/services/userActivityReporter.test.ts src/app/preload/discordInstallBridge.test.ts src/app/renderer/src/lib/utils/appUpdatePolling.test.ts src/app/renderer/src/lib/utils/celebrate.test.ts src/app/shared/diagnosticLogFormatting.test.ts src/app/main/services/diagnosticLogService.test.ts src/app/main/ipc/diagnosticLogIpcHandlers.test.ts src/app/renderer/src/lib/diagnostics/rendererLogging.test.ts src/app/shared/consoleKey.test.ts src/app/main/ipc/settings-ipc-handlers.test.ts src/app/renderer/src/lib/utils/unsavedChanges.test.ts src/app/renderer/src/lib/utils/activeProfiles.test.ts src/app/renderer/src/lib/components/profiles/profileEditor.test.ts src/app/main/consoleSetup/*.test.ts src/app/renderer/src/lib/consoleSetup/*.test.ts src/app/renderer/src/lib/components/navigation/helpNotice.test.ts src/app/renderer/src/lib/components/navigation/onboardingChecks.test.ts",
    "app:check": "svelte-kit sync && svelte-check --tsconfig tsconfig.json --config svelte.config.js",
    "app:renderer:build": "vite build --config src/app/renderer/vite.config.mts",
    "app:renderer:verify": "node scripts/verifyRendererRoutes.mjs",
    "preapp:build": "node --test scripts/normalizeCoreTextBuild.test.mjs",
    "app:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/app-build.ps1",
    "app:dist": "npm run config:write && npm run core:publish && npm run app:build && electron-builder --win nsis --x64",
    "dist:verify": "node scripts/verifyDistribution.mjs",
    "dist:checksums": "node scripts/checksumRelease.mjs",
    "version:check": "node scripts/checkProductVersion.mjs",
    "verify:public": "node scripts/publicPolicy.mjs",
    "dashboard:preview": "vite --config scripts/dashboardPreview.vite.mts"
  },
  "build": {
    "appId": "com.magictrashcan.spellbook",
    "productName": "SpellBook",
    "copyright": "Copyright © 2026 Magic Trashcan",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "SpellBook-Setup-${version}.${ext}",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "executableName": "SpellBook",
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "src/app/renderer/src/lib/components/evilcharts/NOTICE.md",
        "to": "licenses/evilchartsSvNotice.md"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "dist/core/win-x64",
        "to": "core",
        "filter": [
          "**/*",
          "!**/.env*"
        ]
      },
      {
        "from": "src/app/.env",
        "to": "app/.env"
      },
      {
        "from": "src/core/CoreHost/.env",
        "to": "core/.env"
      },
      {
        "from": "LICENSE.md",
        "to": "LICENSE.md"
      },
      {
        "from": "NOTICE.md",
        "to": "NOTICE.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "dist/config/app-config.json",
        "to": "app-config.json"
      }
    ]
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@humanspeak/svelte-motion": "^0.9.4",
    "@js-temporal/polyfill": "^0.5.1",
    "@svelte-plugins/datepicker": "1.0.11",
    "@tiptap/core": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@tiptap/suggestion": "3.30.5",
    "any-ascii": "^0.3.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "discord-markdown-parser": "^1.3.1",
    "dotenv": "^17.4.2",
    "layerchart": "^2.5.0",
    "openapi-fetch": "^0.17.0",
    "uisfx": "^0.4.0",
    "vidstack": "^1.15.6"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "sass": "^1.101.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tsx": "^4.23.0",
    "typescript": "^5.5.4",
    "vite": "7.3.6",
    "wait-on": "^7.2.0"
  }
}
