# Physical input keeps hidden game commands deferred 
Movement__MovingWindowMs=1000

CORE__HOST=127.0.0.1
CORE__PORT=48125
CORE__AUTHTOKEN=changeme
CORE__INSTANCEID=development
CORE__ALLOWRAWCONSOLECOMMAND=true

PROCESS__ALLOWEDNAMES__0=Chivalry2-Win64-Shipping.exe
PROCESS__ALLOWEDNAMES__1=Chivalry2Modded-Win64-Shipping.exe
PROCESS__DISALLOWEDNAMES__0=Chivalry2Launcher.exe
PROCESS__REQUIREX64=true
PROCESS__PATHMUSTCONTAIN=TBL\Binaries\Win64
PROCESS__ALLOWMULTIPLEMATCHES=false

CONSOLE__OPENMODE=NumpadSubtractOnce
CONSOLE__CLOSEMODE=None
CONSOLE__COMMANDINPUTMODE=ClipboardPaste

TIMING__FOCUSTIMEOUTMS=600
TIMING__AFTERFOCUSDELAYMS=0
TIMING__CONSOLEOPENDELAYMS=0
TIMING__BETWEENKEYDELAYMS=0
TIMING__BEFOREENTERDELAYMS=0
TIMING__AFTERACTIONMS=30
TIMING__AFTERCOMMANDDELAYMS=90
TIMING__AFTERQUEUEEMPTYMS=0
TIMING__RESTOREFOCUSDELAYMS=0
TIMING__CLIPBOARDCHANGETIMEOUTMS=3000
TIMING__CLIPBOARDSEQUENCEPOLLINTERVALMS=1
TIMING__LISTPLAYERSCACHETTLMS=500
TIMING__COMMANDTIMEOUTMS=5000

# Crop is sized as a percentage of the game window so 1080p and 4K frame the same area.
# Anchor: Top/Center/Bottom paired with Left/Center/Right, e.g. Center, BottomCenter, TopLeft.
# Offsets nudge from that anchor, also in percent; positive moves right and down.
SNAPSHOT__CROPWIDTHPERCENT=47
SNAPSHOT__CROPHEIGHTPERCENT=13
SNAPSHOT__CROPANCHOR=Center
SNAPSHOT__CROPOFFSETXPERCENT=0
SNAPSHOT__CROPOFFSETYPERCENT=0
# The crop is upscaled to this pixel height before OCR. Windows OCR reads nothing at native
# nameplate size; 420 matches the tested 3x on a 1080p crop and self-adjusts on other resolutions.
SNAPSHOT__TARGETHEIGHT=420
SNAPSHOT__MAXSCALEFACTOR=8
# Levels curve applied before OCR. Nameplate text is near white, so raising the black point
# crushes the background while leaving the glyphs. Same units as a Levels dialog; gamma > 1 brightens.
SNAPSHOT__LEVELSENABLED=true
SNAPSHOT__LEVELSBLACKPOINT=145
SNAPSHOT__LEVELSWHITEPOINT=204
SNAPSHOT__LEVELSGAMMA=1.5
# Tesseract needs dark text on a light page, so the near-white glyphs are flipped.
SNAPSHOT__LEVELSINVERT=true
# Windows or Tesseract. Windows returns nothing once the processed crop contains white noise.
SNAPSHOT__ENGINE=Tesseract
SNAPSHOT__TESSERACTDATAPATH=
# SingleBlock reads noisy nameplates; SingleLine returns nothing on the same image.
SNAPSHOT__TESSERACTPAGESEGMENTATION=SingleBlock
# Overlay name matching. Pass 1 compares whole names; if nothing clears MATCHFULLCONFIDENCE the
# leading then trailing letters are compared instead, each needing its own confidence.
SNAPSHOT__MATCHFULLCONFIDENCE=0.24
SNAPSHOT__MATCHPREFIXLENGTH=4
SNAPSHOT__MATCHPREFIXCONFIDENCE=0.75
SNAPSHOT__MATCHSUFFIXLENGTH=4
SNAPSHOT__MATCHSUFFIXCONFIDENCE=0.75
# Final pass: each whitespace or dash separated word from the OCR text.
SNAPSHOT__MATCHWORDCONFIDENCE=0.6
# A recognised line with more spaces than this is scene noise, not a player name.
SNAPSHOT__MATCHMAXSPACES=7

SNAPSHOT__LANGUAGE=en-US
SNAPSHOT__SAVEDEBUGIMAGES=true
SNAPSHOT__DEBUGFOLDER=
SNAPSHOT__DEBUGRETENTIONSECONDS=300
