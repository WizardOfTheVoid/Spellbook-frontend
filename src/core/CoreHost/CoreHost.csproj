<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Windows 10 TFM unlocks the built-in Windows.Media.Ocr engine used by the snapshot endpoint. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseAppHost>true</UseAppHost>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CoreHost</RootNamespace>
    <AssemblyName>SpellBook.CoreHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AnyAscii" Version="0.3.3" />
    <PackageReference Include="TesseractOCR" Version="5.5.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoreHost.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\packages\shared\assets\consoleKeys.json" LogicalName="consoleKeys.json" />
    <None Include="..\..\..\packages\shared\assets\symbolNormalization.json" Link="symbolNormalization.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="tessdata\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
