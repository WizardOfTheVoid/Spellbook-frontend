# Core API
CORE__HOST=127.0.0.1
CORE__PORT=48125
CORE__AUTHTOKEN=changeme
CORE__INSTANCEID=development

# Game process
PROCESS__ALLOWEDNAMES__0=Chivalry2-Win64-Shipping.exe
PROCESS__ALLOWEDNAMES__1=Chivalry2Modded-Win64-Shipping.exe
PROCESS__DISALLOWEDNAMES__0=Chivalry2Launcher.exe
PROCESS__REQUIREX64=true
PROCESS__PATHMUSTCONTAIN=TBL\Binaries\Win64
PROCESS__ALLOWMULTIPLEMATCHES=false

# Queue gates (ms; high 0 bypasses physical input)
QUEUE_GATE_NORMAL=1900
QUEUE_GATE_LOW=1900
QUEUE_GATE_HIGH=0

# Queue limits and timing (ms)
QUEUE__COMMANDTIMEOUTMS=5000
QUEUE__ACTIONTTLMS=10000
QUEUE__RECHECKMS=25
QUEUE__MAXPENDINGACTIONS=999

# Window timing (ms)
WINDOW__FOCUSTIMEOUTMS=600
WINDOW__FOCUSSETTLEMS=30
WINDOW__RESTORESETTLEMS=50
WINDOW__PROCESSPOLLMS=1000

# Input timing (ms)
INPUT__CHATCOOLDOWNMS=25000
INPUT__SUBMITSETTLEMS=20

# Clipboard timing (ms)
CLIPBOARD__OUTPUTTIMEOUTMS=3000
CLIPBOARD__POLLMS=1

# Debug
DEBUG__EVENTLIMIT=500
DEBUG__SESSIONLEASEMS=2000

# Snapshot crop (%)
SNAPSHOT__CROPWIDTHPERCENT=47
SNAPSHOT__CROPHEIGHTPERCENT=13
SNAPSHOT__CROPANCHOR=Center
SNAPSHOT__CROPOFFSETXPERCENT=0
SNAPSHOT__CROPOFFSETYPERCENT=0

# Snapshot scale
SNAPSHOT__TARGETHEIGHT=420
SNAPSHOT__MAXSCALEFACTOR=8

# Snapshot levels
SNAPSHOT__LEVELSENABLED=true
SNAPSHOT__LEVELSBLACKPOINT=145
SNAPSHOT__LEVELSWHITEPOINT=204
SNAPSHOT__LEVELSGAMMA=1.5
SNAPSHOT__LEVELSINVERT=true

# Snapshot OCR
SNAPSHOT__ENGINE=Tesseract
SNAPSHOT__TESSERACTDATAPATH=
SNAPSHOT__TESSERACTPAGESEGMENTATION=SingleBlock
SNAPSHOT__LANGUAGE=en-US

# Snapshot name matching
SNAPSHOT__MATCHFULLCONFIDENCE=0.24
SNAPSHOT__MATCHPREFIXLENGTH=4
SNAPSHOT__MATCHPREFIXCONFIDENCE=0.75
SNAPSHOT__MATCHSUFFIXLENGTH=4
SNAPSHOT__MATCHSUFFIXCONFIDENCE=0.75
SNAPSHOT__MATCHWORDCONFIDENCE=0.6
SNAPSHOT__MATCHMAXSPACES=7

# Snapshot debug
SNAPSHOT__SAVEDEBUGIMAGES=true
SNAPSHOT__DEBUGFOLDER=
SNAPSHOT__DEBUGRETENTIONSECONDS=300
