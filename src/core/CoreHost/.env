# Physical input keeps hidden game commands deferred for this many milliseconds.
Movement__MovingWindowMs=1500
CORE__HOST=127.0.0.1
CORE__PORT=48125
CORE__AUTHTOKEN=dev-local-token
CORE__ALLOWRAWCONSOLECOMMAND=true

PROCESS__ALLOWEDNAMES__0=Chivalry2-Win64-Shipping.exe
PROCESS__ALLOWEDNAMES__1=Chivalry2Modded-Win64-Shipping.exe
PROCESS__DISALLOWEDNAMES__0=Chivalry2Launcher.exe
PROCESS__REQUIREX64=true
PROCESS__PATHMUSTCONTAIN=TBL\Binaries\Win64
PROCESS__ALLOWMULTIPLEMATCHES=false

CONSOLE__OPENMODE=NumpadSubtractOnce
CONSOLE__CLOSEMODE=None
CONSOLE__COMMANDINPUTMODE=ClipboardPaste

TIMING__FOCUSTIMEOUTMS=600
TIMING__AFTERFOCUSDELAYMS=30
TIMING__CONSOLEOPENDELAYMS=0
TIMING__BETWEENKEYDELAYMS=0
TIMING__BEFOREENTERDELAYMS=0
TIMING__AFTERACTIONMS=15
TIMING__AFTERCOMMANDDELAYMS=0
TIMING__AFTERQUEUEEMPTYMS=0
TIMING__RESTOREFOCUSDELAYMS=50
TIMING__CLIPBOARDCHANGETIMEOUTMS=3000
TIMING__CLIPBOARDSEQUENCEPOLLINTERVALMS=1
TIMING__LISTPLAYERSCACHETTLMS=500
TIMING__COMMANDTIMEOUTMS=5000

# Crop is sized as a percentage of the game window so 1080p and 4K frame the same area.
# Anchor: Top/Center/Bottom paired with Left/Center/Right, e.g. Center, BottomCenter, TopLeft.
# Offsets nudge from that anchor, also in percent; positive moves right and down.
SNAPSHOT__CROPWIDTHPERCENT=26
SNAPSHOT__CROPHEIGHTPERCENT=4.5
SNAPSHOT__CROPANCHOR=BottomCenter
SNAPSHOT__CROPOFFSETXPERCENT=0
SNAPSHOT__CROPOFFSETYPERCENT=-8.5
SNAPSHOT__TARGETHEIGHT=200
SNAPSHOT__MAXSCALEFACTOR=3

SNAPSHOT__LEVELSENABLED=true
SNAPSHOT__LEVELSBLACKPOINT=145
SNAPSHOT__LEVELSWHITEPOINT=204
SNAPSHOT__LEVELSGAMMA=1.5
SNAPSHOT__LEVELSINVERT=true

SNAPSHOT__ENGINE=Tesseract
SNAPSHOT__TESSERACTDATAPATH=

SNAPSHOT__TESSERACTPAGESEGMENTATION=SingleBlock
SNAPSHOT__MATCHFULLCONFIDENCE=0.41
SNAPSHOT__MATCHPREFIXLENGTH=4
SNAPSHOT__MATCHPREFIXCONFIDENCE=0.20
SNAPSHOT__MATCHSUFFIXLENGTH=4
SNAPSHOT__MATCHSUFFIXCONFIDENCE=0.20
SNAPSHOT__MATCHWORDCONFIDENCE=0.60
SNAPSHOT__MATCHMAXSPACES=7

SNAPSHOT__LANGUAGE=en-US
SNAPSHOT__SAVEDEBUGIMAGES=true
SNAPSHOT__DEBUGFOLDER=
SNAPSHOT__DEBUGRETENTIONSECONDS=300
