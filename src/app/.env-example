# LOCAL CORE
CHIV_CORE_TOKEN=changeme

# ANTI-AFK
ANTI_AFK_INTERVAL_SECONDS=50 # Seconds between Anti-AFK sequences
ANTI_AFK_MINIMUM_IDLE_MINUTES=1 # Required physical movement-key idle time before a sequence runs
ANTI_AFK_KEYS="W:70,S:70" # Ordered KEY:DURATION_MS presses; add comma-separated entries as needed
# Notifications
NOTIFICATION_POLL_SECONDS=10

# PULSES:
PULSE_LOW_MS=6000
PULSE_NORMAL_MS=3000
PULSE_HIGH_MS=1500
PULSE_SENTINEL_MS=500

DEBUG_STATUS_INTERVAL_MS=100
DEBUG_HISTORY_LIMIT=500
DEBUG_RUN_LIMIT=100
