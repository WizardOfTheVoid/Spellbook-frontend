# ANTI-AFK
ANTI_AFK_INTERVAL_SECONDS=120 # Seconds between Anti-AFK sequences
ANTI_AFK_MINIMUM_IDLE_MINUTES=2 # Required physical movement-key idle time before a sequence runs
ANTI_AFK_KEYS="W:20,S:20" # Ordered KEY:DURATION_MS presses; add comma-separated entries as needed
GAME_ACTIVITY_RECHECK_MS=550 # Recheck hidden game work blocked by recent physical input
# Notifications and Wanted runtime

# Notification and Wanted runtime
NOTIFICATION_POLL_SECONDS=10

# AUTO PULSES
LISTPLAYERS_POLL_SECONDS=12
LISTPLAYERS_SENTINEL_POLL_SECONDS=5

# WANTED SYSTEM
# Var Tags mimick normal txt vars in-app: [user] player name or PlayFab ID, [duration] hours or MAX, [admin] executing admin, [playfab] PlayFab ID
# [server_name] server name, [clan_name] clan name, [clan_tag] clan tag, [action] banned/unbanned/mocked
# [type] offense type, [reason] original reason, plus any configured server variable as [key]
# Optional fallback syntax: [key|fallback]
WANTED_POLL_SECONDS=5
WANTED_SENTINEL_POLL_SECONDS=2
WANTED_MESSAGE_PREFIX='[SB Wanted] '
WANTED_MOCK_MESSAGE='[Mock] "[user]" has been automatically community-[action] for: [type]'
WANTED_ACTION_MESSAGE='"[user]" has been automatically community-[action] for: [type]'
