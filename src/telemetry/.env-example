# Main supplies these per launch. The worker does not load an .env file.
# Never reuse the Core token or persist the telemetry bearer token.
TELEMETRY_ROOT=C:\Users\example\AppData\Roaming\SpellBook\telemetry\31\recordings
TELEMETRY_TOKEN=<fresh random 32-byte hex secret supplied by Main>
TELEMETRY_INSTANCE=<fresh UUID supplied by Main>
TELEMETRY_PARENT_PID=<Main process ID>
TELEMETRY_VERSION=<matching application version>
