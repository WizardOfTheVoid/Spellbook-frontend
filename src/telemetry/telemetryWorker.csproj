<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SpellBook.Telemetry</AssemblyName>
    <RootNamespace>SpellBook.Telemetry</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**/*.test.cs;tests/**" />
    <Content Remove="tests/**;**/*.test.cs;.env*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

</Project>
